# Copy to ~/.config/jarvis/brain.env (install.sh does this).
# Brain binds loopback only.
JARVIS_BUS_HOST=127.0.0.1
JARVIS_BUS_PORT=8765
JARVIS_TTS_PROVIDER=piper
# JARVIS_PIPER_BIN=$HOME/.local/share/jarvis/piper/piper/piper
# JARVIS_PIPER_MODEL=$HOME/.local/share/jarvis/piper/voices/es_ES-davefx-medium.onnx
# JARVIS_PIPER_ESPEAK=$HOME/.local/share/jarvis/piper/piper/espeak-ng-data
# HERMES_BIN=$HOME/.local/share/jarvis/hermes-agent/.venv/bin/hermes
# JARVIS_VOICE_JARVIS=$HOME/.local/share/jarvis/voices/jarvis.wav
# JARVIS_HA_URL=http://homeassistant.local:8123
# JARVIS_HA_TOKEN=
# JARVIS_YOLO_DETECT=$HOME/.local/share/jarvis/detect.py
# JARVIS_PRESENCE_HOWDY=0
# JARVIS_VISION_CLICK=0
# JARVIS_PROFILE=desk
# JARVIS_WATCH_QUIET=23:00-07:00
